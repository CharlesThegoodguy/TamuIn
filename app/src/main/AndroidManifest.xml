<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".TamuInApp166"
        android:allowBackup="true"
        android:icon="@drawable/ic_book_166"
        android:label="@string/app_name_166"
        android:roundIcon="@drawable/ic_book_166"
        android:supportsRtl="true"
        android:theme="@style/Theme.TamuIn166">

        <!-- LoginActivity166: Launcher Activity -->
        <activity
            android:name=".ui.auth.LoginActivity166"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- RegisterActivity166 -->
        <activity
            android:name=".ui.auth.RegisterActivity166"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- DashboardActivity166 -->
        <activity
            android:name=".ui.dashboard.DashboardActivity166"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />

        <!-- GuestFormActivity166 -->
        <activity
            android:name=".ui.form.GuestFormActivity166"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>
