<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark theme variant adapting to system dark mode. -->
    <style name="Theme.TamuIn159" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/accent_blue_159</item>
        <item name="colorOnPrimary">@color/white_159</item>
        <item name="colorPrimaryContainer">@color/accent_blue_subtle_159</item>
        <item name="colorOnPrimaryContainer">@color/accent_blue_159</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/accent_blue_159</item>
        <item name="colorOnSecondary">@color/white_159</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/bg_screen_159</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/bg_screen_159</item>

        <!-- Surface & Background -->
        <item name="android:colorBackground">@color/bg_screen_159</item>
        <item name="colorSurface">@color/surface_card_159</item>
        <item name="colorOnSurface">@color/text_primary_159</item>
    </style>
</resources>
